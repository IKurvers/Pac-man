name:                Pac-man
version:             0.1.0.0
author:              Alejandro Serrano
maintainer:          A.SerranoMena@uu.nl
category:            Game
build-type:          Simple
cabal-version:       >=1.10


executable Pac-man
  main-is:             Main.hs
  build-depends:       base >= 4 && < 5,
                       containers,
                       gloss,
                       random,
                       gloss-juicy
  hs-source-dirs:      .
  other-modules:       Controller
                     , Model
                     , View
                     , Player
                     , BaseGhost
  default-language:    Haskell2010